{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Origin\u2013destination flow map: top five export destinations for almonds and macadamias, 2022/23.",
  "width": 1000,
  "height": 470,
  "projection": {
    "type": "equalEarth",
    "rotate": [
      -110,
      0,
      0
    ]
  },
  "params": [
    {
      "name": "nutFilter",
      "value": "All",
      "bind": {
        "input": "radio",
        "options": [
          "All",
          "Almonds",
          "Macadamias"
        ],
        "name": "Show exports of: "
      }
    }
  ],
  "layer": [
    {
      "data": {
        "sphere": true
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f6f1ea"
      }
    },
    {
      "data": {
        "url": "data/world_countries.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e9e1d5",
        "stroke": "#ffffff",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "data/world_countries.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.NAME == 'Australia'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#d6c3a8",
        "stroke": "#ffffff"
      }
    },
    {
      "data": {
        "url": "data/export_flows_2023.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "filter": "nutFilter == 'All' || datum.properties.nut == nutFilter"
        }
      ],
      "mark": {
        "type": "geoshape",
        "filled": false,
        "strokeCap": "round",
        "opacity": 0.75
      },
      "encoding": {
        "stroke": {
          "field": "properties.nut",
          "type": "nominal",
          "title": "Nut",
          "scale": {
            "domain": [
              "Almonds",
              "Macadamias"
            ],
            "range": [
              "#C8702A",
              "#2E7D6B"
            ]
          },
          "legend": {
            "orient": "bottom-left"
          }
        },
        "strokeWidth": {
          "field": "properties.tonnes",
          "type": "quantitative",
          "title": "Tonnes exported",
          "scale": {
            "domain": [
              0,
              35000
            ],
            "range": [
              0.5,
              16
            ]
          },
          "legend": {
            "orient": "bottom-left",
            "values": [
              1000,
              10000,
              30000
            ],
            "labelExpr": "format(datum.value, ',')",
            "symbolType": "stroke"
          }
        },
        "tooltip": [
          {
            "field": "properties.nut",
            "title": "Nut"
          },
          {
            "field": "properties.destination",
            "title": "Destination"
          },
          {
            "field": "properties.tonnes",
            "type": "quantitative",
            "format": ",",
            "title": "Tonnes"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/export_destinations_2023.csv",
        "format": {
          "parse": {
            "tonnes": "number",
            "lon": "number",
            "lat": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "nutFilter == 'All' || datum.nut == nutFilter"
        },
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "tonnes",
              "as": "total"
            }
          ],
          "groupby": [
            "destination",
            "lon",
            "lat"
          ]
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "circle",
            "color": "#3b322b",
            "size": 30,
            "opacity": 1
          }
        },
        {
          "transform": [
            {
              "filter": "datum.destination != 'Japan'"
            }
          ],
          "mark": {
            "type": "text",
            "dy": -10,
            "fontWeight": 600,
            "fontSize": 12,
            "color": "#3b322b"
          },
          "encoding": {
            "text": {
              "field": "destination"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.destination == 'Japan'"
            }
          ],
          "mark": {
            "type": "text",
            "dx": 8,
            "dy": 4,
            "align": "left",
            "fontWeight": 600,
            "fontSize": 12,
            "color": "#3b322b"
          },
          "encoding": {
            "text": {
              "field": "destination"
            }
          }
        }
      ],
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        }
      }
    }
  ],
  "config": {
    "font": "Source Sans 3",
    "background": null,
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "labelColor": "#5a4e44",
      "titleColor": "#5a4e44",
      "gridColor": "#ece3d6",
      "domainColor": "#c9bcab",
      "tickColor": "#c9bcab"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "labelColor": "#5a4e44",
      "titleColor": "#5a4e44"
    },
    "text": {
      "font": "Source Sans 3",
      "fontSize": 12,
      "fill": "#3b322b"
    }
  }
}