{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Choropleth: number of commercial nut crops recorded in each state, 2023/24.",
  "width": 440,
  "height": 380,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -134,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/aus_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "aus_states"
        }
      },
      "transform": [
        {
          "calculate": "'No commercial nut production recorded in ' + datum.properties.STATE_NAME",
          "as": "note"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#ece8e2",
        "stroke": "#ffffff",
        "strokeWidth": 1
      },
      "encoding": {
        "tooltip": {
          "field": "note"
        }
      }
    },
    {
      "data": {
        "url": "data/aus_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "aus_states"
        }
      },
      "transform": [
        {
          "lookup": "properties.STATE_NAME",
          "from": {
            "data": {
              "url": "data/state_summary_2024.csv"
            },
            "key": "state",
            "fields": [
              "nut_types",
              "nuts_grown"
            ]
          }
        },
        {
          "filter": "datum.nut_types > 0"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 1.2
      },
      "encoding": {
        "color": {
          "field": "nut_types",
          "type": "ordinal",
          "title": "Nut crops grown",
          "scale": {
            "domain": [
              3,
              5,
              6,
              7
            ],
            "range": [
              "#f3d9b9",
              "#dfa46b",
              "#b8682f",
              "#7a3d17"
            ]
          }
        },
        "tooltip": [
          {
            "field": "properties.STATE_NAME",
            "title": "State"
          },
          {
            "field": "nut_types",
            "title": "Nut crops grown"
          },
          {
            "field": "nuts_grown",
            "title": "Crops"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "abbr": "WA",
            "lon": 122,
            "lat": -26
          },
          {
            "abbr": "NT",
            "lon": 133.5,
            "lat": -20
          },
          {
            "abbr": "SA",
            "lon": 135.5,
            "lat": -30
          },
          {
            "abbr": "QLD",
            "lon": 144.5,
            "lat": -23
          },
          {
            "abbr": "NSW",
            "lon": 146.5,
            "lat": -32.5
          },
          {
            "abbr": "VIC",
            "lon": 144,
            "lat": -37
          },
          {
            "abbr": "TAS",
            "lon": 146.6,
            "lat": -42
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontWeight": 700,
        "fontSize": 11,
        "color": "#3b322b",
        "opacity": 0.75
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "abbr"
        }
      }
    }
  ],
  "config": {
    "font": "Source Sans 3",
    "background": null,
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "labelColor": "#5a4e44",
      "titleColor": "#5a4e44",
      "gridColor": "#ece3d6",
      "domainColor": "#c9bcab",
      "tickColor": "#c9bcab"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "labelColor": "#5a4e44",
      "titleColor": "#5a4e44"
    },
    "text": {
      "font": "Source Sans 3",
      "fontSize": 12,
      "fill": "#3b322b"
    }
  }
}